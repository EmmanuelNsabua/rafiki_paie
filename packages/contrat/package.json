{
  "name": "@rafiki/contrat",
  "version": "0.1.4",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    },
    "./canaux": {
      "types": "./dist/canaux.d.ts",
      "import": "./dist/canaux.mjs",
      "default": "./dist/canaux.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "typescript": "5.8.2"
  }
}
