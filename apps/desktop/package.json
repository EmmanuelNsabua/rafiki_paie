{
  "name": "@rafiki/desktop",
  "version": "0.1.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/EmmanuelNsabua/rafiki_paie.git"
  },
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "tsup && node -e \"require('fs').cpSync('migrations', 'dist/main/migrations', { recursive: true })\"",
    "build:icons": "node ../../scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "db:seed": "node ../../scripts/run-electron-node.mjs dist/main/seed.js",
    "dev": "npm run build && concurrently -k \"npm run dev --workspace=@rafiki/web\" \"wait-on http://localhost:3000 && node ../../scripts/run-electron-gui.mjs\"",
    "build:electron": "electron-builder --win nsis",
    "build:electron:dir": "electron-builder --dir",
    "test": "npm run build && node ../../scripts/run-desktop-tests.mjs run apps/desktop/tests",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@rafiki/calcul": "*",
    "@rafiki/contrat": "*",
    "better-sqlite3": "12.11.1",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.11",
    "xlsx": "^0.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "electron": "42.11.18",
    "electron-builder": "26.18.0",
    "tsup": "9.0.0",
    "typescript": "5.8.2",
    "wait-on": "8.0.4"
  },
  "author": "École RAFIKI",
  "description": "École RAFIKI — Gestionnaire de paie",
  "build": {
    "appId": "com.starclip.paie",
    "productName": "École RAFIKI",
    "copyright": "© 2026 École RAFIKI",
    "publish": {
      "provider": "github",
      "owner": "EmmanuelNsabua",
      "repo": "rafiki_paie"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Ecole-RAFIKI",
      "artifactName": "Ecole-RAFIKI-Setup-${version}.${ext}",
      "legalTrademarks": "© 2026 École RAFIKI",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "École RAFIKI",
      "runAfterFinish": true,
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/out",
        "to": "web/out",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
